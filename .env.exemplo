# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o Git.
# A tela de login sempre oferece "Entrar sem login"; para obrigar o login, use ORGANIZADOR_EXIGIR_LOGIN=1.

# --- Entrar com Google (Google Cloud Console > APIs e serviços > Credenciais) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Entrar com Microsoft / Outlook (Azure Portal > Microsoft Entra ID > Registros de aplicativo) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" aceita contas pessoais (Outlook/Hotmail) e corporativas; ou o ID do tenant da empresa
MS_TENANT_ID=common

# --- Opcionais ---
# 1 = remove o botão "Entrar sem login" (só entra com Google/Microsoft)
ORGANIZADOR_EXIGIR_LOGIN=0
# Só e-mails destes domínios podem entrar (separe por vírgula). Vazio = qualquer conta.
ORGANIZADOR_DOMINIOS=
# Endereço público do organizador (no GitHub Codespaces é detectado sozinho)
ORGANIZADOR_URL_BASE=
# 1 = ler links do SharePoint/OneDrive de toda a organização com permissão de APLICATIVO
# (exige MS_TENANT_ID da empresa e consentimento do administrador)
MS_PERMISSAO_APLICATIVO=0
